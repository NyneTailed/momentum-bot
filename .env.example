# Kopiere diese Datei zu ".env" und trage deinen DEMO-API-Key ein.
# Bitget: oben rechts auf "Demo-Trading" umschalten -> Profil -> API-Key-Verwaltung -> Demo-API-Key erstellen
# Rechte: nur "Futures: Lesen + Handeln". KEINE Auszahlungsrechte!
BITGET_API_KEY=
BITGET_API_SECRET=
BITGET_PASSPHRASE=

# true = Demogeld (Standard). Nur auf false stellen, wenn du bewusst mit Echtgeld handeln willst.
BITGET_DEMO=true
